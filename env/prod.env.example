# Copy to env/prod.env (ignored by version control). Bundled in the app: never put real secrets here.
APP_NAME=My App
API_BASE_URL=https://api.example.com
CONNECT_TIMEOUT_MS=15000
RECEIVE_TIMEOUT_MS=15000
LOG_LEVEL=warning
ENABLE_CRASH_REPORTING=true
ENABLE_ANALYTICS=false
CRASH_DSN=
# Empty: the installed version is used. Set to test the update gate.
APP_VERSION=
REMOTE_CONFIG_PATH=/app/config
REMOTE_CONFIG_MOCK=false
