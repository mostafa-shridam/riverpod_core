# Copy to env/staging.env (ignored by version control). Bundled in the app: never put real secrets here.
APP_NAME=My App Staging
API_BASE_URL=https://staging-api.example.com
CONNECT_TIMEOUT_MS=15000
RECEIVE_TIMEOUT_MS=15000
LOG_LEVEL=info
ENABLE_CRASH_REPORTING=true
ENABLE_ANALYTICS=false
CRASH_DSN=
APP_VERSION=1.0.0
REMOTE_CONFIG_PATH=/app/config
REMOTE_CONFIG_MOCK=false
