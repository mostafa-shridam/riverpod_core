# Copy to env/dev.env (ignored by version control). Bundled in the app: never put real secrets here.
APP_NAME=My App Dev
API_BASE_URL=http://10.0.2.2:8080
CONNECT_TIMEOUT_MS=15000
RECEIVE_TIMEOUT_MS=15000
LOG_LEVEL=debug
ENABLE_CRASH_REPORTING=false
ENABLE_ANALYTICS=false
CRASH_DSN=
# Empty: the installed version is used. Set to test the update gate.
APP_VERSION=
REMOTE_CONFIG_PATH=/app/config
REMOTE_CONFIG_MOCK=false
