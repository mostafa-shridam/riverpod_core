part '{{name}}_repository.g.dart';

/// {{Title}} data for the page. Returns models or throws an [AppException];
/// JSON and `DioException` never leave this class.
class {{Name}}Repository {
  {{Name}}Repository(this._source, this._cache);

  final {{Name}}RemoteSource _source;
  final CachedRepositoryHelper _cache;

  /// The ONE read of the list: every caller goes through this method.
  /// Cache-first (D-038): the cached list comes back at once when there is one,
  /// and the revalidation runs in the background. [fresh] is for refresh: it
  /// waits for the network and raises a failure even when a cached list exists.
  Future<List<{{Name}}Item>> fetchItems({bool fresh = false}) =>
      _cache.load<List<{{Name}}Item>>(
        key: '{{name}}.items',
        fetch: (_) => _guard(
          () async => (value: await _source.fetchItems(), etag: null),
        ),
        decode: (payload) => [
          for (final item in jsonDecode(payload) as List<dynamic>)
            {{Name}}Item.fromJson(item as Map<String, dynamic>),
        ],
        encode: (items) =>
            jsonEncode([for (final item in items) item.toJson()]),
        policy: CachePolicy.medium,
        fresh: fresh,
      );

  Future<T> _guard<T>(Future<T> Function() call) async {
    try {
      return await call();
    } on AppException {
      rethrow;
    } on DioException catch (error, stack) {
      // The Dio error-mapping interceptor already wrapped an AppException.
      final inner = error.error;
      throw inner is AppException ? inner : mapError(error, stack);
    } on Object catch (error, stack) {
      throw mapError(error, stack);
    }
  }
}

/// The source the repository reads from. Tests override it.
@Riverpod(keepAlive: true)
{{Name}}RemoteSource {{nameCamel}}RemoteSource(Ref ref) {
  return {{Name}}RemoteSource(ref.watch(dioProvider));
}

@Riverpod(keepAlive: true)
{{Name}}Repository {{nameCamel}}Repository(Ref ref) {
  return {{Name}}Repository(
    ref.watch({{nameCamel}}RemoteSourceProvider),
    ref.watch(cachedRepositoryHelperProvider),
  );
}
