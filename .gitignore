# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/
# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Environment files: real values are ignored, *.env.example are committed (D-024)
env/*.env
!env/*.env.example

# Agent worktrees
.claude/worktrees/

# Release signing and symbols (never commit; see tool/release/README.md)
android/key.properties
*.jks
*.keystore
ios/ExportOptions.plist
*.mobileprovision
build-symbols/

# Firebase config belongs to each app, never to the template (D-042)
google-services.json
GoogleService-Info.plist

# Flutter golden-test failure output and Gradle reports are build artifacts
**/test/**/failures/
/android/build/
